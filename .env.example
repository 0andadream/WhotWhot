# ── Deploy (contracts) ──────────────────────────────────────────
# Funded Base mainnet wallet (ETH for gas). Never commit this file.
PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=

# Optional override (defaults to Megapot JackpotTicketNFT on Base)
# TICKET_NFT_ADDRESS=0x48FfE35AbB9f4780a4f1775C2Ce1c46185b366e4

# ── Frontend (also written to frontend/.env.local by deploy script) ──
NEXT_PUBLIC_WHOT_ESCROW_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_WC_PROJECT_ID=
# Earn Megapot referral fees on ticket buys from this app
# Default in code: 0xFD3f8634674C8e8d3A3dec78B90bC9417Ebef2f0
NEXT_PUBLIC_REFERRER_ADDRESS=0xFD3f8634674C8e8d3A3dec78B90bC9417Ebef2f0
NEXT_PUBLIC_SOURCE_TAG=whotwhot
# ── Stake vs Agent (Agent wallet stakes a ticket; winner takes both) ──
# Public Agent address (default: 0xFD3f…ef2f0)
NEXT_PUBLIC_AGENT_ADDRESS=0xFD3f8634674C8e8d3A3dec78B90bC9417Ebef2f0
# Server-only: private key FOR THAT SAME WALLET. Required for Challenge Agent.
# Fund wallet with ETH (gas) + USDC (buy tickets). Funding alone is not enough.
# AGENT_PRIVATE_KEY=0x...
# Legacy alias also accepted: AI_HOUSE_PRIVATE_KEY

# ── Move relay (multiplayer card plays, no gas) ─────────────────
# Local `next dev`: in-memory store works (both players need same server).
# Vercel production: REQUIRED free Upstash Redis so both wallets share one log.
# https://console.upstash.com → Redis → REST API → copy URL + token
# (Also accepts Vercel KV: KV_REST_API_URL + KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: private Base RPC (Alchemy/QuickNode) reduces public RPC rate limits
# BASE_RPC_URL=

